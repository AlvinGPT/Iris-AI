{
  "name": "iris-ai-studio",
  "private": true,
  "version": "1.0.0",
  "description": "IRIS AI Studio - Intelligent Posture & Eye Health Daemon",
  "author": "IRIS AI Team",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:icons": "node scripts/generate-ico.cjs",
    "build:server": "node scripts/build-server.cjs",
    "build:electron": "node scripts/build-electron.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-electron release server.js",
    "lint": "tsc --noEmit",
    "dist:win": "npm run build && npm run build:server && npm run build:electron && electron-builder --win dir nsis portable",
    "dist:setup": "npm run build && npm run build:server && npm run build:electron && electron-builder --win nsis",
    "dist:portable": "npm run build && npm run build:server && npm run build:electron && electron-builder --win portable"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.9.1",
    "@google/genai": "^2.4.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@travisvn/edge-tts": "^1.0.2",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "koffi": "^3.3.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sharp": "^0.32.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.iris.ai.desktop",
    "productName": "IRIS",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json",
      ".env"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/koffi/**/*"
    ],
    "win": {
      "icon": "public/assets/icon.ico",
      "target": [
        "dir",
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "IRIS-Setup.exe"
    },
    "portable": {
      "artifactName": "IRIS-Portable.exe"
    }
  }
}
