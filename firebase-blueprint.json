{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information synchronized upon Google Sign-In",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "format": "email",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL",
          "maxLength": 1024
        },
        "lastLoginAt": {
          "type": "string",
          "description": "ISO timestamp of last sign in",
          "maxLength": 64
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user account profile and ophthalmic session settings"
    }
  }
}
